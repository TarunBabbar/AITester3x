# ---------------------------------------------------------------------------
# OpenRouter LLM configuration (everything configurable here)
# ---------------------------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OpenRouter exposes an OpenAI-compatible endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free model verified working. Swap for any model on OpenRouter
# (e.g. anthropic/claude-3.5-sonnet) for better code quality.
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=8000
OPENROUTER_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# Page reader (Playwright)
# ---------------------------------------------------------------------------
# Seconds to wait for the page to load before reading it
PAGE_READ_TIMEOUT_MS=30000
# Run the browser in headless mode (set false to watch it)
PAGE_READ_HEADLESS=true
# Strip interactive elements to reduce token size (true is safer for long pages)
PAGE_READ_SLIM=true
# Max links to capture in the page snapshot
PAGE_READ_MAX_LINKS=40

# ---------------------------------------------------------------------------
# Agent identity / behaviour
# ---------------------------------------------------------------------------
AGENT_VERBOSE=false
CREW_VERBOSE=false

# ---------------------------------------------------------------------------
# Test runner
# ---------------------------------------------------------------------------
# Run `npm install` before `npx playwright test` (slow on first run)
TEST_RUNNER_AUTO_INSTALL=true
# Run `npx playwright install chromium` before tests (large download, do once)
TEST_RUNNER_BROWSER_INSTALL=false
# Show generated framework files in the UI (default true)
SHOW_GENERATED_FILES=true

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
