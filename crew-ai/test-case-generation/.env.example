# ---------------------------------------------------------------------------
# OpenRouter LLM configuration
# ---------------------------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OpenRouter exposes an OpenAI-compatible endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free-tier model
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=8000
OPENROUTER_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Agent identity
# ---------------------------------------------------------------------------
AGENT_ROLE=Senior Test Analyst
AGENT_GOAL=Analyse the given feature requirement and generate clear, prioritised (P0-P3) test cases that cover happy path, edge cases and negative scenarios.
AGENT_BACKSTORY=You are a senior QA engineer with 15 years of experience in test planning, risk-based testing and test case authoring.
AGENT_VERBOSE=true
CREW_VERBOSE=true

# ---------------------------------------------------------------------------
# The requirement to analyse (free text) - override as needed
# ---------------------------------------------------------------------------
REQUIREMENT=app.vwo.com Login page with username, password, a submit button and a 'Remember Me' checkbox functionality.